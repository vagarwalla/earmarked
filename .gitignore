# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# press — local pipeline state, extracted articles, and generated issues
.press/

# Agent worktrees. These are git worktrees, not files: committed, they become
# gitlinks with no .gitmodules entry, and every Vercel build fails to clone
# them ("Failed to fetch one or more git submodules") then dies at upload.
.claude/worktrees/
